{
	"name": "taro-ad-fields",
	"version": "1.0.0",
	"description": "Advertise block manager for WordPress.",
	"directories": {
		"test": "tests"
	},
	"scripts": {
		"prepare": "husky",
		"test": "RESULT=${PWD##*/} && wp-env run tests-cli ./wp-content/plugins/$RESULT/vendor/bin/phpunit -c ./wp-content/plugins/$RESULT/phpunit.xml.dist",
		"start": "wp-env start",
		"update": "wp-env start --update",
		"stop": "wp-env stop",
		"env": "wp-env",
		"cli": "wp-env run cli wp",
		"cli:test": "wp-env run tests-cli wp",
		"dump": "grab-deps dump assets",
		"package": "npm run build:js && npm run build:css && npm run dump",
		"build": "npm run package",
		"build:js": "grab-deps js src/js assets/js",
		"build:css": "sass ./src/scss/:./assets/css/ --style=compressed && postcss ./assets/css/**/*.css --use autoprefixer --replace",
		"lint:css": "wp-scripts lint-style './src/scss/**/*.scss'",
		"lint:js": "wp-scripts lint-js './src/js/**/*.js'",
		"lint": "npm run lint:css && npm run lint:js",
		"format:css": "stylelint \"src/scss/**/*.scss\" --fix",
		"format:js": "eslint --fix 'src/js/**/*.js'",
		"watch": "npm-watch"
	},
	"repository": {
		"type": "git",
		"url": ""
	},
	"keywords": [],
	"author": "",
	"license": "GPL-3.0-or-later",
	"bugs": {
		"url": ""
	},
	"homepage": "",
	"devDependencies": {
		"@kunoichi/grab-deps": "^3.0.0",
		"@wordpress/env": "^11.16",
		"@wordpress/scripts": "^36.0.0",
		"autoprefixer": "^10.4.16",
		"husky": "^9.1.7",
		"lint-staged": "^17.6.0",
		"npm-watch": "^0.13.0",
		"postcss": "^8.4.33",
		"postcss-cli": "^12.0.0",
		"sass": "^1.69.7"
	},
	"lint-staged": {
		"*.js": "npm run lint:js",
		"*.scss": "npm run lint:css",
		"*.php": "composer lint"
	},
	"watch": {
		"build:js": {
			"extensions": "js",
			"patterns": [
				"src/js"
			]
		},
		"lint:js": {
			"extensions": "js",
			"patterns": [
				"src/js"
			]
		},
		"build:css": {
			"extensions": "scss",
			"patterns": [
				"src/scss"
			]
		},
		"lint:css": {
			"extensions": "scss",
			"patterns": [
				"src/scss"
			]
		},
		"dump": {
			"extensions": "js,css",
			"patterns": [
				"assets/js",
				"assets/css"
			]
		}
	},
	"engines": {
		"node": ">=22.0"
	}
}
